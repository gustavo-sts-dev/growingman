# Copie para .env.local e ajuste os valores.

# URL base da API, incluindo o prefixo /api.
# Desenvolvimento: http://localhost:3333/api
# Produção:        https://grow.gustavo-s-sts.com.br/api
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# URL pública do frontend, sem barra no final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage de objetos. Duas origens porque o upload e a leitura passam por
# caminhos diferentes, e a CSP (next.config.ts) precisa liberar cada uma:
#  - UPLOAD: endpoint S3 para onde o navegador envia via presigned URL.
#            Em produção, https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#  - PUBLIC: domínio que serve as imagens já gravadas.
# Sem estas variáveis o upload é bloqueado por CSP e as imagens não carregam.
NEXT_PUBLIC_STORAGE_UPLOAD_URL=http://localhost:9000
NEXT_PUBLIC_STORAGE_PUBLIC_URL=http://localhost:9000

# Web Push (VAPID): chave PÚBLICA para o navegador assinar as notificações de
# agendamento. Precisa ser IDÊNTICA à VAPID_PUBLIC_KEY do backend. Gerar o par
# com `npx web-push generate-vapid-keys` (a privada fica só no backend).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
