{
	"scripts": {
		"dev": "concurrently \"pnpm --filter backend_v2 dev\" \"pnpm --filter frontend_v2 dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
		"dev:backend": "pnpm --filter backend_v2 dev",
		"dev:frontend": "pnpm --filter frontend_v2 dev",
		"build": "concurrently \"pnpm --filter backend_v2 build\" \"pnpm --filter frontend_v2 build\"",
		"build:backend": "pnpm --filter backend_v2 build",
		"build:frontend": "pnpm --filter frontend_v2 build"
	},
	"devDependencies": {
		"concurrently": "^9.2.1"
	}
}
